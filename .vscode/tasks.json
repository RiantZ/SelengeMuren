{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cmake-configure-debug",
            "type": "shell",
            "command": "cmake",
            "args": ["--preset", "macos-debug-local-kit"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "cmake-build-debug-tests",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/_Build_mac_debug",
                "--target",
                "P8_RegressionTests"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": ["cmake-configure-debug"],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        }
    ]
}
